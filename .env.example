# Copy to .env (gitignored) and fill in. Read by the Vite dev server only:
# these variables have no VITE_ prefix, so they never reach the browser bundle.

# Base URL of the API stage: https://<api-id>.execute-api.eu-west-3.amazonaws.com/staging
# <api-id>: aws apigateway get-rest-apis --profile kaamelott --region eu-west-3 \
#             --query "items[?name=='kaamelott-api-staging'].id" --output text
KAAMELOTT_API_URL=

# Value of the Secrets Manager secret kaamelott-web-api-key-staging:
#   aws secretsmanager get-secret-value --secret-id kaamelott-web-api-key-staging \
#     --profile kaamelott --region eu-west-3 --query SecretString --output text
KAAMELOTT_API_KEY=
